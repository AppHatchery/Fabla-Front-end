# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Deploy pre-built APK to Firebase App Distribution"
  lane :deploy_to_firebase do
    release_notes = generate_release_notes

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"].strip,
      groups: "testers",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"].strip,
#       service_credentials_json_data: ENV["CREDENTIAL_FILE_CONTENT"],
      android_artifact_path: "../build/app/outputs/flutter-apk/app-debug.apk",
      android_artifact_type: "APK",
      release_notes: release_notes
    )
  end

  private_lane :generate_release_notes do
    base_notes = File.exist?("../release_notes.txt") ? File.read("../release_notes.txt").strip : "No release notes provided."

    [
      base_notes,
      "\n\n🔨 Build Info:",
      "- Branch: #{ENV['GITHUB_REF_NAME'] || 'unknown'}",
      "- Commit: #{(ENV['GITHUB_SHA'] || 'unknown')[0, 7]}",
      "- Build ##{ENV['GITHUB_RUN_NUMBER'] || '1'}",
      "- Built on: #{Time.now.strftime('%Y-%m-%d %H:%M:%S UTC')}"
    ].join("\n")
  end
end
