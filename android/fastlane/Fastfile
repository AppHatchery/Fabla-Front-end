default_platform(:android)

PUBSPEC_PATH = "../../pubspec.yaml"

platform :android do

  # ──────────────────────────────────────────────
  # Debug → Firebase App Distribution
  # ──────────────────────────────────────────────
  desc "Deploy pre-built debug APK to Firebase App Distribution"
  lane :deploy_to_firebase do
    ensure_env_vars(
      env_vars: ["FIREBASE_APP_ID_ANDROID", "FIREBASE_CLI_TOKEN"]
    )

    release_notes = generate_release_notes

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"].strip,
      groups: "testers",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"].strip,
      android_artifact_path: "../build/app/outputs/flutter-apk/app-debug.apk",
      android_artifact_type: "APK",
      release_notes: release_notes
    )

    UI.success("Debug APK deployed to Firebase App Distribution")
  end

  # ──────────────────────────────────────────────
  # Private helpers
  # ──────────────────────────────────────────────
  private_lane :generate_release_notes do
    base_notes = File.exist?("../release_notes.txt") ? File.read("../release_notes.txt").strip : "No release notes provided."

    [
      base_notes,
      "\n\nBuild Info:",
      "- Branch: #{ENV['GITHUB_REF_NAME'] || 'unknown'}",
      "- Commit: #{(ENV['GITHUB_SHA'] || 'unknown')[0, 7]}",
      "- Build ##{ENV['GITHUB_RUN_NUMBER'] || '1'}",
      "- Built on: #{Time.now.strftime('%Y-%m-%d %H:%M:%S UTC')}"
    ].join("\n")
  end

end
