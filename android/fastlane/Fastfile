default_platform(:android)

PUBSPEC_PATH = "../../pubspec.yaml"

platform :android do

  # ──────────────────────────────────────────────
  # Debug → Firebase App Distribution
  # ──────────────────────────────────────────────
  desc "Deploy pre-built debug APK to Firebase App Distribution"
  lane :deploy_to_firebase do
    ensure_env_vars(
      env_vars: ["FIREBASE_APP_ID_ANDROID", "FIREBASE_CLI_TOKEN"]
    )

    release_notes = generate_release_notes

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_ANDROID"].strip,
      groups: "testers",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"].strip,
      android_artifact_path: "../build/app/outputs/flutter-apk/app-debug.apk",
      android_artifact_type: "APK",
      release_notes: release_notes
    )

    UI.success("Debug APK deployed to Firebase App Distribution")
  end

  # ──────────────────────────────────────────────
  # Release → Play Store (scaffold — enable when ready)
  # ──────────────────────────────────────────────
  desc "Deploy release AAB to Google Play internal track"
  lane :deploy_to_play_store do
    ensure_env_vars(
      env_vars: ["PLAY_STORE_JSON_KEY"]
    )

    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["PLAY_STORE_JSON_KEY"],
      package_name: "edu.emory.audio_diaries_flutter",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Release AAB uploaded to Play Store internal track")
  end

  # ──────────────────────────────────────────────
  # Version management
  # ──────────────────────────────────────────────
  desc "Bump build number in pubspec.yaml"
  lane :bump_build_number do
    pubspec = File.read(PUBSPEC_PATH)
    current_version_line = pubspec.match(/^version:\s*(.+)$/)

    UI.user_error!("Could not find version in pubspec.yaml") unless current_version_line

    full_version = current_version_line[1].strip
    parts = full_version.split("+")
    version_name = parts[0]
    build_number = (parts[1] || "0").to_i + 1

    new_version = "#{version_name}+#{build_number}"
    new_pubspec = pubspec.gsub(/^version:\s*.+$/, "version: #{new_version}")
    File.write(PUBSPEC_PATH, new_pubspec)

    UI.success("Bumped version to #{new_version}")
    new_version
  end

  desc "Read current version from pubspec.yaml"
  lane :current_version do
    pubspec = File.read(PUBSPEC_PATH)
    match = pubspec.match(/^version:\s*(.+)$/)
    UI.user_error!("Could not find version in pubspec.yaml") unless match
    version = match[1].strip
    UI.message("Current version: #{version}")
    version
  end

  # ──────────────────────────────────────────────
  # CI signing helpers
  # ──────────────────────────────────────────────
  desc "Decode base64 keystore from CI secret and write to disk"
  lane :setup_signing do
    ensure_env_vars(
      env_vars: [
        "KEYSTORE_BASE64",
        "KEYSTORE_PASSWORD",
        "KEY_ALIAS",
        "KEY_PASSWORD"
      ]
    )

    require "base64"

    keystore_path = File.expand_path("../app/upload-keystore.jks")
    File.write(keystore_path, Base64.decode64(ENV["KEYSTORE_BASE64"]))

    key_properties_path = File.expand_path("../key.properties")
    File.write(key_properties_path, [
      "storePassword=#{ENV['KEYSTORE_PASSWORD']}",
      "keyPassword=#{ENV['KEY_PASSWORD']}",
      "keyAlias=#{ENV['KEY_ALIAS']}",
      "storeFile=#{keystore_path}"
    ].join("\n"))

    UI.success("Signing config written to #{key_properties_path}")
  end

  desc "Clean up signing artifacts after build"
  lane :cleanup_signing do
    keystore_path = File.expand_path("../app/upload-keystore.jks")
    key_properties_path = File.expand_path("../key.properties")

    File.delete(keystore_path) if File.exist?(keystore_path)
    File.delete(key_properties_path) if File.exist?(key_properties_path)

    UI.success("Signing artifacts cleaned up")
  end

  # ──────────────────────────────────────────────
  # Private helpers
  # ──────────────────────────────────────────────
  private_lane :generate_release_notes do
    base_notes = File.exist?("../release_notes.txt") ? File.read("../release_notes.txt").strip : "No release notes provided."

    [
      base_notes,
      "\n\nBuild Info:",
      "- Branch: #{ENV['GITHUB_REF_NAME'] || 'unknown'}",
      "- Commit: #{(ENV['GITHUB_SHA'] || 'unknown')[0, 7]}",
      "- Build ##{ENV['GITHUB_RUN_NUMBER'] || '1'}",
      "- Built on: #{Time.now.strftime('%Y-%m-%d %H:%M:%S UTC')}"
    ].join("\n")
  end

end
