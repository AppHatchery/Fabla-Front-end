{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "audio-diaries",
          "appId": "1:645895584054:android:9a8fa3e27b5aab0b4a5b97",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "audio-diaries",
          "appId": "1:645895584054:ios:aa3ccda0502986ff4a5b97",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "audio-diaries",
          "configurations": {
            "android": "1:645895584054:android:9a8fa3e27b5aab0b4a5b97",
            "ios": "1:645895584054:ios:aa3ccda0502986ff4a5b97"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
