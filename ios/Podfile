# Uncomment this line to define a global platform for your project
 platform :ios, '15.0'
# Ensure this line is not commented out
 use_frameworks!

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# flutter_foreground_task 11.0.2 ships the Obj-C shim that GeneratedPluginRegistrant.m
# needs (FlutterForegroundTaskPlugin) at ios/flutter_foreground_task/Classes/, but its
# podspec globs it as 'Classes/**/*.{h,m}' — a path that does not exist. Under CocoaPods
# the shim is therefore never compiled and the build fails with
# "Unknown receiver 'FlutterForegroundTaskPlugin'". Remove this once upstream fixes the glob.
pre_install do |installer|
  installer.analysis_result.specifications.each do |spec|
    next unless spec.name == 'flutter_foreground_task'
    spec.attributes_hash['source_files'] = [
      'flutter_foreground_task/Sources/flutter_foreground_task/**/*.swift',
      'flutter_foreground_task/Classes/**/*.{h,m}',
    ]
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
              '$(inherited)',
        
              ## dart: PermissionGroup.reminders
              # 'PERMISSION_REMINDERS=1',
        
              ## dart: PermissionGroup.microphone
                'PERMISSION_MICROPHONE=1',

              ## dart: PermissionGroup.notification
               'PERMISSION_NOTIFICATIONS=1',

              ## dart: PermissionGroup.camera
               'PERMISSION_CAMERA=1',

            ]
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    ################  Awesome Notifications pod modification  ###################
      awesome_pod_file = File.expand_path(File.join('plugins', 'awesome_notifications', 'ios', 'Scripts', 'AwesomePodFile'), '.symlinks')
      require awesome_pod_file
      update_awesome_pod_build_settings(installer)
      ################  Awesome Notifications pod modification  ###################
    end
      
    ################  Awesome Notifications pod modification  ###################
    awesome_pod_file = File.expand_path(File.join('plugins', 'awesome_notifications', 'ios', 'Scripts', 'AwesomePodFile'), '.symlinks')
    require awesome_pod_file
    update_awesome_main_target_settings('Runner', File.dirname(File.realpath(__FILE__)), flutter_root)
    ################  Awesome Notifications pod modification  ###################
end
